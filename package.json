{
  "name": "atlas-terminal",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "atlas": "node scripts/start.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:ui": "playwright test",
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/map-assets.mjs",
    "prebuild": "node scripts/map-assets.mjs",
    "develop": "node scripts/develop.mjs",
    "test:backend": "node scripts/python.mjs -m pytest -q",
    "lint:python": "node scripts/python.mjs -m ruff check backend scripts",
    "verify:release": "node scripts/python.mjs scripts/check_release.py",
    "package": "npm run build && node scripts/python.mjs scripts/package_release.py",
    "refresh:public": "node scripts/python.mjs scripts/refresh_public_data.py",
    "refresh:annual": "node scripts/python.mjs scripts/refresh_annual.py"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@fontsource/inter": "^5.2.8",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
